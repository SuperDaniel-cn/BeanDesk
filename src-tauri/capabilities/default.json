{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "BeanDesk window. HTTP is limited to http and https; the app only calls the saved Fava origin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "log:default",
    "updater:default",
    "process:allow-restart",
    "allow-start-saved-fava",
    "allow-stop-saved-fava",
    "allow-fava-host",
    "allow-init-ledger",
    "allow-system-locales",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" }
      ]
    }
  ]
}
