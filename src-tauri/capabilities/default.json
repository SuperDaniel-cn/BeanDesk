{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "BeanDesk window. HTTP is limited to http and https; the app only calls the saved Fava origin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "log:default",
    "updater:default",
    "process:allow-restart",
    "allow-start-saved-fava",
    "allow-stop-saved-fava",
    "allow-fava-host",
    "allow-init-ledger",
    "allow-read-user-text-file",
    "allow-system-locales",
    "notification:default",
    "allow-load-backup-settings",
    "allow-save-backup-settings",
    "allow-backup-status",
    "allow-backup-now",
    "allow-backup-set-key",
    "allow-backup-restore",
    "allow-backup-snapshots",
    "allow-backup-test-s3",
    "allow-backup-open-workdir",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" }
      ]
    }
  ]
}
