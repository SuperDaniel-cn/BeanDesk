{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeanDesk",
  "mainBinaryName": "BeanDesk",
  "version": "0.2.6",
  "identifier": "app.beandesk.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:5188",
    "beforeDevCommand": {
      "script": "bun run ensure-docs && bun run dev",
      "cwd": "../web"
    },
    "beforeBuildCommand": {
      "script": "bun run ensure-docs && bun run build",
      "cwd": "../web"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BeanDesk",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/engine/": "engine/",
      "binaries/restic/": "restic/",
      "infoplist/zh-Hans.lproj/": "zh-Hans.lproj/",
      "infoplist/zh_CN.lproj/": "zh_CN.lproj/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QTQyMTRFNEFBQUFENkUKUldSdXJhcEtUaUdrNlpzNVM4eGVQcldrbmJ0YVNBWVdYbWpTb0ZoK096NlV2WG9yY0c2U0lLOTIK",
      "endpoints": [
        "https://github.com/SuperDaniel-cn/BeanDesk/releases/latest/download/latest.json"
      ]
    }
  }
}
